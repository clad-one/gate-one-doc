{
  "authProvider": {
    "type": "oidc",
    "issuer": "https://auth.example.com/realms/company",
    "clientId": "gate-one",
    "clientSecretEnv": "OIDC_CLIENT_SECRET",
    "loginBaseUrl": "https://login.example.com",
    "cookieDomain": "example.com"
  },
  "routes": [
    {
      "host": "app.example.com",
      "path": "/*",
      "frontend": true,
      "backend": "http://app:8080",
      "auth": {},
      "userBadge": {
        "position": "right",
        "claims": [
          "preferred_username",
          "email"
        ]
      }
    },
    {
      "host": "reports.example.com",
      "path": "/*",
      "frontend": true,
      "backend": "http://reports:8080",
      "auth": {},
      "userBadge": {
        "position": "right",
        "claims": [
          "preferred_username",
          "email"
        ]
      }
    }
  ]
}
