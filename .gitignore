# Hugo build output and cache
/public/
/resources/
.hugo_build.lock

# Node dependencies (Hugo extended, Bootstrap, Font Awesome, Dart Sass)
/node_modules/

# Release artefacts (attached to a tag, never committed)
/dist/

# Local site generated by scripts/gen-config-docs
# (the generator is the source of truth; keep the committed output in Git)
# no generated config pages are ignored: they are committed so a clone
# builds without running the generator first.

# Local environment
.env
.env.*
!.env.example
