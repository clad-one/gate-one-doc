{
  "authProvider": {
    "type": "http-bridge",
    "baseUrl": "http://legacy-bridge:8080",
    "loginUrl": "https://login.example.com/login",
    "issuer": "https://auth.example.com/realms/example",
    "headers": {
      "userId": "X-User-Id",
      "username": "X-Username",
      "email": "X-Email",
      "roles": "X-Roles",
      "scopes": "X-Scopes",
      "claims": "X-Claims"
    }
  },
  "routes": [{
    "host": "app.example.com",
    "path": "/*",
    "frontend": true,
    "backend": "http://app:8080",
    "auth": {}
  }]
}
