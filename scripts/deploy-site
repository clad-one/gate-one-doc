#!/usr/bin/env bash
# Deploy the static site to Cloudflare Pages. Credentials come from the
# environment (CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID), never from
# this repository. Other static hosts work too: the output is `public/`.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

PROJECT="${CLOUDFLARE_PAGES_PROJECT:-gate-one-product}"
if [ "${1:-}" = "--dry-run" ]; then
	echo "deploy-site: would build public/ and run:"
	echo "  wrangler pages deploy public --project-name $PROJECT"
	exit 0
fi
if ! command -v wrangler >/dev/null 2>&1; then
	echo "deploy-site: wrangler is required (npm i -g wrangler)" >&2
	exit 1
fi
"$PWD/scripts/build-site"
exec wrangler pages deploy public --project-name "$PROJECT"
